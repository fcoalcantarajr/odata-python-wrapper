# Variáveis lidas pelo client e pelos integration tests.
# Copie pra .env (gitignored) se rodar fora do devcontainer.
AZURE_DEVOPS_PAT=
AZURE_DEVOPS_ORG=
AZURE_DEVOPS_PROJECT=

# === Notion MCP (Step 10) ===
# Internal integration token from notion.so/profile/integrations.
# Scope it to read+update of the workspace pages under NOTION_ROOT_PAGE_ID.
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Root page id (without dashes) under which notion-curator will mirror specs/, docs/, AGENTS.md.
# Example: 0123abcd45ef67890123abcd45ef6789
NOTION_ROOT_PAGE_ID=0123abcd45ef67890123abcd45ef6789
