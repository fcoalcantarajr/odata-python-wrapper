# Copie pra .devcontainer/devcontainer.env (gitignored) e preencha.
# Reload Window (ou Rebuild Container) após editar.

# Azure DevOps Analytics OData — PAT com escopo MÍNIMO:
#   - Analytics (read)
#   - Work items (read)
# NÃO use escopo "Full" — attack surface desnecessária.
# Gere em: https://dev.azure.com/<org>/_usersSettings/tokens
AZURE_DEVOPS_PAT=

# Organização e projeto-alvo dos testes de integração.
AZURE_DEVOPS_ORG=
AZURE_DEVOPS_PROJECT=